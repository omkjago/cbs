# Application Environment Configuration
APP_NAME="NMS-GIS Fiber Optic Monitoring"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (MySQL / MariaDB or SQLite for testing)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nms_gis_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# SQLite fallback path (used if DB_DRIVER=sqlite)
DB_SQLITE_PATH=database/database.sqlite

# Security & Encryption Keys
# APP_KEY must be a 64-character hex string (32 bytes) for AES-256-GCM
APP_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret Token Key
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_2026
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# CORS Allowed Origins (Comma separated, or * for dev)
CORS_ALLOWED_ORIGINS=*

# Rate Limiting (Login: attempts / window seconds)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=300

# Polling & System Defaults
POLLING_INTERVAL_SECONDS=120
TEMP_LOG_RETENTION_DAYS=7
RX_POWER_WARNING_THRESHOLD=-25.00
RX_POWER_CRITICAL_THRESHOLD=-28.00
